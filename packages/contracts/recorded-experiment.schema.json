        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "client": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricGroup"
            },
            {
              "type": "null"
            }
          ]
        },
        "requests": {
          "$ref": "#/$defs/MetricGroup"
        },
        "restarts": {
          "$ref": "#/$defs/MetricGroup"
        },
        "status": {
          "const": "CAPTURED",
          "title": "Status",
          "type": "string"
        },
        "window_seconds": {
          "exclusiveMinimum": 0,
          "title": "Window Seconds",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "captured_at",
        "window_seconds",
        "availability",
        "restarts",
        "requests",
        "client"
      ],
      "title": "Baseline",
      "type": "object"
    },
