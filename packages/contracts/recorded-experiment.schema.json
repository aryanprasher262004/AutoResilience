            },
            {
              "type": "null"
            }
          ],
          "title": "Phase"
        },
        "probe_success_percentage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Probe Success Percentage"
        },
        "verdict": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verdict"
        }
      },
      "required": [
        "phase",
        "verdict",
        "fail_step",
        "probe_success_percentage"
      ],
      "title": "ChaosResult",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
