# AutoResilience API — example environment (no real values; copy to .env)
# APP_NAME=
# ENVIRONMENT=
# DATABASE_URL=   (default postgresql+psycopg://postgres:postgres@localhost:5432/autoresilience, provided by scripts/dev-db.sh)
# PROMETHEUS_URL=http://localhost:9090
# PROMETHEUS_TIMEOUT_SECONDS=
# BASELINE_WINDOW_SECONDS=
# FRONTEND_ORIGIN=
# KUBE_CONTEXT=kind-autoresilience
# KUBE_REQUEST_TIMEOUT_SECONDS=
# CHAOS_START_TIMEOUT_SECONDS=
# CHAOS_POLL_INTERVAL_SECONDS=
# OBSERVATION_GRACE_SECONDS=
# RECOVERY_TIMEOUT_SECONDS=
# RECOVERY_STABLE_SAMPLES=
# RECOVERY_MAX_SAMPLE_GAP_SECONDS=
# RECOVERY_ERROR_RATIO_TOLERANCE=
# ORCHESTRATOR_ENABLED=true
# ORCHESTRATOR_INTERVAL_SECONDS=
# BASELINE_TIMEOUT_SECONDS=
# ORCHESTRATION_MAX_SECONDS=
# CLEANUP_GRACE_SECONDS=
